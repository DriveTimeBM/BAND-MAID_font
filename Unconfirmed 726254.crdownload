/* BAND-MAID display face — glyph definitions.
 * Cap-height = 100. Each glyph is an SVG path within its own viewBox.
 * `extend` is the amount the glyph reaches above the cap-line (for peaks/swooshes)
 * or below the baseline (for V/W tails). It's baked into the viewBox padding.
 */
(function () {
  // Geometric constants used while designing — kept as comments for reference:
  //   stroke weight  ≈ 22 of 100
  //   chamfer        ≈ 14
  //   swoosh peak    extends ~10 above cap-line, ~12 to left of stem

  const G = {};

  // ----- letters from the actual logo, lifted/regularized -----

  // A — sharp peak, asymmetric: left side leans inward more than right
  G['A'] = { w: 86, ext: { top: 6, bot: 0, left: 0, right: 0 },
    d: 'M 42 -6 L 86 100 L 64 100 L 51 60 L 31 60 L 16 100 L 0 100 Z' +
       ' M 42 22 L 50 52 L 32 52 Z',
    rule: 'evenodd' };

  // B — stem + 2 angular bowls, with the signature top-left swoosh peak
  G['B'] = { w: 76, ext: { top: 10, bot: 0, left: 12, right: 0 },
    d: 'M -12 -10 L 52 0 L 76 26 L 26 50 L 76 74 L 52 100 L 0 100 L 0 22 Z' +
       ' M 22 14 L 50 14 L 60 26 L 22 38 Z' +
       ' M 22 62 L 60 74 L 50 86 L 22 86 Z',
    rule: 'evenodd' };

  // N — slanted middle, vertical legs with sharp top-left and bottom-right peaks
  G['N'] = { w: 80, ext: { top: 6, bot: 0, left: 0, right: 0 },
    d: 'M 0 -6 L 22 0 L 62 70 L 62 0 L 80 0 L 80 100 L 58 100 L 18 30 L 18 100 L 0 100 Z' };

  // D — stem + single big angular bowl, with top-left swoosh
  G['D'] = { w: 76, ext: { top: 10, bot: 0, left: 12, right: 0 },
    d: 'M -12 -10 L 52 0 L 76 50 L 52 100 L 0 100 L 0 22 Z' +
       ' M 22 14 L 50 18 L 60 50 L 50 82 L 22 86 Z',
    rule: 'evenodd' };

  // M — two pointed peaks like /\/\, valley dips in the middle
  G['M'] = { w: 110, ext: { top: 6, bot: 0, left: 0, right: 0 },
    d: 'M 0 100 L 24 -6 L 55 60 L 86 -6 L 110 100 L 88 100 L 82 6 L 55 76 L 28 6 L 22 100 Z' };

  // I — leaning bar with chamfers on upper-right + lower-left
  G['I'] = { w: 24, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 0 L 14 0 L 24 14 L 24 100 L 10 100 L 0 86 Z' };

  // ----- the rest of A–Z, designed in the same vocabulary -----

  // C — chamfered ring with right-side opening
  G['C'] = { w: 76, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 76 22 L 60 0 L 16 0 L 0 22 L 0 78 L 16 100 L 60 100 L 76 78 L 54 78 L 48 88 L 22 88 L 14 78 L 14 22 L 22 12 L 48 12 L 54 22 Z' };

  // E — three bars; right ends chamfered
  G['E'] = { w: 68, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 0 L 56 0 L 68 12 L 68 18 L 22 18 L 22 42 L 58 42 L 58 60 L 22 60 L 22 82 L 68 82 L 68 88 L 56 100 L 0 100 Z' };

  // F — top bar + middle bar, no bottom bar; stem ends chamfered
  G['F'] = { w: 66, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 0 L 54 0 L 66 12 L 66 18 L 22 18 L 22 42 L 56 42 L 56 60 L 22 60 L 22 90 L 12 100 L 0 100 Z' };

  // G — C with an inward tongue on the right
  G['G'] = { w: 84, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 84 22 L 68 0 L 16 0 L 0 22 L 0 78 L 16 100 L 68 100 L 84 78 L 84 50 L 50 50 L 50 66 L 66 66 L 66 80 L 60 84 L 22 84 L 14 78 L 14 22 L 22 12 L 60 12 L 66 22 L 84 22 Z' };

  // H — two stems + crossbar, all terminals chamfered (matching I)
  G['H'] = { w: 84, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 0 L 14 0 L 22 14 L 22 42 L 62 42 L 62 14 L 70 0 L 84 0 L 84 86 L 74 100 L 62 100 L 62 60 L 22 60 L 22 100 L 10 100 L 0 86 Z' };

  // J — top serif + hook at bottom going left
  G['J'] = { w: 62, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 18 0 L 62 0 L 62 78 L 50 100 L 22 100 L 0 88 L 0 70 L 22 70 L 26 86 L 40 86 L 44 78 L 44 18 L 26 18 Z' };

  // K — stem + two diagonals meeting on stem; chamfered terminals
  G['K'] = { w: 82, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 0 L 14 0 L 22 14 L 22 46 L 60 0 L 82 0 L 46 52 L 82 100 L 60 100 L 22 56 L 22 100 L 10 100 L 0 86 Z' };

  // L — stem + bottom bar; chamfered top + right end of bar
  G['L'] = { w: 66, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 0 L 14 0 L 22 14 L 22 82 L 56 82 L 66 92 L 66 100 L 0 100 Z' };

  // O — chamfered hexagon, hollow
  G['O'] = { w: 80, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 80 22 L 58 0 L 22 0 L 0 22 L 0 78 L 22 100 L 58 100 L 80 78 Z' +
       ' M 14 28 L 28 14 L 52 14 L 66 28 L 66 72 L 52 86 L 28 86 L 14 72 Z',
    rule: 'evenodd' };

  // P — stem + single bowl + swoosh
  G['P'] = { w: 72, ext: { top: 10, bot: 0, left: 12, right: 0 },
    d: 'M -12 -10 L 52 0 L 72 26 L 22 50 L 22 100 L 0 100 L 0 22 Z' +
       ' M 22 14 L 50 14 L 60 26 L 22 38 Z',
    rule: 'evenodd' };

  // Q — O with a slash exiting bottom-right
  G['Q'] = { w: 82, ext: { top: 0, bot: 14, left: 0, right: 6 },
    d: 'M 82 22 L 60 0 L 22 0 L 0 22 L 0 78 L 22 100 L 60 100 L 82 78 Z' +
       ' M 14 28 L 28 14 L 54 14 L 68 28 L 68 72 L 54 86 L 28 86 L 14 72 Z' +
       ' M 62 76 L 88 114 L 70 114 L 50 84 Z',
    rule: 'evenodd' };

  // R — P with a leg
  G['R'] = { w: 82, ext: { top: 10, bot: 0, left: 12, right: 0 },
    d: 'M -12 -10 L 52 0 L 72 26 L 22 50 L 50 50 L 82 100 L 60 100 L 32 60 L 22 60 L 22 100 L 0 100 L 0 22 Z' +
       ' M 22 14 L 50 14 L 60 26 L 22 38 Z',
    rule: 'evenodd' };

  // S — zig-zag with chamfered corners
  G['S'] = { w: 72, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 12 0 L 72 0 L 72 14 L 60 22 L 22 22 L 22 38 L 60 38 L 72 50 L 72 86 L 60 100 L 0 100 L 0 86 L 12 78 L 50 78 L 50 62 L 12 62 L 0 50 L 0 14 Z' };

  // T — top bar + stem; chamfered horizontals and bottom
  G['T'] = { w: 76, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 0 L 76 0 L 76 10 L 64 18 L 46 18 L 46 90 L 38 100 L 30 90 L 30 18 L 12 18 L 0 10 Z' };

  // U — two stems with chamfered bowl bottom
  G['U'] = { w: 82, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 0 L 14 0 L 22 14 L 22 70 L 30 84 L 52 84 L 60 70 L 60 14 L 68 0 L 82 0 L 82 78 L 60 100 L 22 100 L 0 78 Z' };

  // V — two diagonals meeting in a sharp peak below the baseline
  G['V'] = { w: 84, ext: { top: 0, bot: 10, left: 0, right: 0 },
    d: 'M 0 0 L 20 0 L 42 78 L 64 0 L 84 0 L 50 110 L 34 110 Z' };

  // W — two V's
  G['W'] = { w: 130, ext: { top: 0, bot: 10, left: 0, right: 0 },
    d: 'M 0 0 L 18 0 L 32 78 L 56 0 L 74 0 L 98 78 L 112 0 L 130 0 L 102 110 L 86 110 L 65 30 L 44 110 L 28 110 Z' };

  // X — two diagonals crossing
  G['X'] = { w: 82, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 0 L 18 0 L 41 38 L 64 0 L 82 0 L 51 50 L 82 100 L 64 100 L 41 62 L 18 100 L 0 100 L 31 50 Z' };

  // Y — Y with a sharp center join
  G['Y'] = { w: 82, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 0 L 18 0 L 41 48 L 64 0 L 82 0 L 50 60 L 50 90 L 41 100 L 32 90 L 32 60 Z' };

  // Z — top bar + diagonal + bottom bar
  G['Z'] = { w: 72, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 0 L 72 0 L 72 18 L 28 84 L 72 84 L 72 100 L 0 100 L 0 82 L 44 16 L 0 16 Z' };

  // ----- digits -----

  G['0'] = { w: 72, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 72 22 L 50 0 L 22 0 L 0 22 L 0 78 L 22 100 L 50 100 L 72 78 Z' +
       ' M 14 30 L 28 16 L 44 16 L 58 30 L 58 70 L 44 84 L 28 84 L 14 70 Z',
    rule: 'evenodd' };

  // 1 — vertical stem with down-left flag at the top + flared base bar
  G['1'] = { w: 58, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 38 0 L 46 8 L 46 82 L 58 82 L 58 100 L 0 100 L 0 82 L 20 82 L 20 22 L 0 22 Z' };

  G['2'] = { w: 68, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 16 L 16 0 L 52 0 L 68 16 L 68 42 L 18 84 L 68 84 L 68 100 L 0 100 L 0 76 L 50 32 L 50 22 L 18 22 L 18 34 L 0 34 Z' };

  G['3'] = { w: 68, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 0 L 52 0 L 68 16 L 68 38 L 56 46 L 68 54 L 68 86 L 52 100 L 16 100 L 0 84 L 0 70 L 18 70 L 22 84 L 46 84 L 50 78 L 50 60 L 16 60 L 16 42 L 50 42 L 50 24 L 46 18 L 22 18 L 18 32 L 0 32 Z' };

  // 4 — right vertical + crossbar, with the diagonal closing the upper-left triangle
  G['4'] = { w: 70, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 50 0 L 62 0 L 70 10 L 70 100 L 50 100 L 50 76 L 0 76 L 0 60 Z' };

  G['5'] = { w: 68, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 0 L 68 0 L 68 16 L 22 16 L 22 36 L 52 36 L 68 52 L 68 84 L 52 100 L 16 100 L 0 84 L 0 70 L 18 70 L 22 84 L 46 84 L 50 78 L 50 60 L 46 54 L 0 54 Z' };

  // 6 — closed angular bowl at the bottom + a clean diagonal tail up to a sharp peak
  G['6'] = { w: 70, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 62 0 L 70 22 L 70 86 L 58 100 L 12 100 L 0 86 L 0 50 L 8 36 L 50 36 Z' +
       ' M 12 50 L 18 44 L 50 44 L 58 50 L 58 86 L 50 92 L 20 92 L 12 86 Z',
    rule: 'evenodd' };

  G['7'] = { w: 70, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 0 L 70 0 L 70 18 L 32 100 L 12 100 L 50 18 L 0 18 Z' };

  G['8'] = { w: 70, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 12 0 L 58 0 L 70 14 L 70 36 L 58 46 L 70 54 L 70 86 L 58 100 L 12 100 L 0 86 L 0 54 L 12 46 L 0 36 L 0 14 Z' +
       ' M 22 14 L 18 22 L 18 32 L 26 38 L 44 38 L 52 32 L 52 22 L 48 14 Z' +
       ' M 24 56 L 16 64 L 16 78 L 24 86 L 46 86 L 54 78 L 54 64 L 46 56 Z',
    rule: 'evenodd' };

  G['9'] = { w: 70, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 18 0 L 52 0 L 70 16 L 70 70 L 46 100 L 20 100 L 18 84 L 30 84 L 50 84 L 52 68 L 40 68 L 20 68 L 0 50 L 0 16 Z' +
       ' M 18 22 L 18 46 L 24 52 L 46 52 L 52 46 L 52 22 L 46 14 L 24 14 Z',
    rule: 'evenodd' };

  // ----- punctuation lifted/inferred from the logo -----

  // hyphen (the logo's "-" is a diamond/rhombus)
  G['-'] = { w: 38, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 50 L 19 36 L 38 50 L 19 64 Z' };

  // period — small angular tile near baseline
  G['.'] = { w: 22, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 86 L 11 78 L 22 86 L 22 100 L 11 100 L 0 100 Z' };

  // comma
  G[','] = { w: 22, ext: { top: 0, bot: 14, left: 0, right: 0 },
    d: 'M 0 86 L 11 78 L 22 86 L 22 100 L 12 114 L 4 114 L 14 100 L 0 100 Z' };

  // colon
  G[':'] = { w: 22, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 30 L 11 22 L 22 30 L 22 44 L 11 44 L 0 44 Z' +
       ' M 0 86 L 11 78 L 22 86 L 22 100 L 11 100 L 0 100 Z' };

  // exclam
  G['!'] = { w: 24, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 0 L 14 0 L 24 14 L 24 64 L 12 76 L 0 64 Z' +
       ' M 0 86 L 12 78 L 24 86 L 24 100 L 12 100 L 0 100 Z' };

  // question
  G['?'] = { w: 64, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 0 18 L 16 0 L 50 0 L 64 14 L 64 38 L 42 56 L 42 68 L 22 68 L 22 48 L 44 32 L 44 22 L 18 22 L 18 32 L 0 32 Z' +
       ' M 22 86 L 32 78 L 42 86 L 42 100 L 32 100 L 22 100 Z' };

  // forward slash
  G['/'] = { w: 60, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 44 0 L 60 0 L 16 100 L 0 100 Z' };

  // space — zero-width-ish placeholder, w handled in renderer
  G[' '] = { w: 40, ext: { top: 0, bot: 0, left: 0, right: 0 }, d: '' };

  // apostrophe / quote
  G["'"] = { w: 18, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 4 0 L 14 0 L 18 12 L 14 32 L 4 32 L 0 12 Z' };

  // ampersand — angular take
  G['&'] = { w: 84, ext: { top: 0, bot: 0, left: 0, right: 0 },
    d: 'M 16 0 L 56 0 L 70 14 L 70 30 L 44 50 L 60 70 L 70 56 L 84 64 L 70 84 L 84 100 L 60 100 L 52 92 L 36 100 L 14 100 L 0 84 L 0 64 L 22 46 L 16 36 L 16 14 Z' +
       ' M 30 14 L 28 30 L 34 38 L 50 26 L 50 18 L 46 14 Z' +
       ' M 22 60 L 16 70 L 16 78 L 24 86 L 36 86 L 46 80 L 30 60 Z',
    rule: 'evenodd' };

  // diacritic-less – treat lowercase as same as uppercase
  for (let c = 'a'.charCodeAt(0); c <= 'z'.charCodeAt(0); c++) {
    G[String.fromCharCode(c)] = G[String.fromCharCode(c - 32)];
  }

  window.BM_GLYPHS = G;

  /* Renderer: produce an SVG element for a string in the BAND-MAID face. */
  window.BM_renderText = function (text, opts) {
    opts = opts || {};
    const fill = opts.fill || 'currentColor';
    const tracking = opts.tracking == null ? 6 : opts.tracking;   // px @ cap-height 100
    const cap = opts.cap || 100;
    const scale = cap / 100;
    const padTop = opts.padTop != null ? opts.padTop : 14;
    const padBot = opts.padBot != null ? opts.padBot : 14;

    let x = 0;
    let maxTop = 0, maxBot = 0;
    let minLeft = 0, maxRight = 0;
    const placed = [];
    for (const ch of text) {
      const g = G[ch];
      if (!g) { x += 40; continue; }
      placed.push({ g, x });
      maxTop = Math.max(maxTop, g.ext.top || 0);
      maxBot = Math.max(maxBot, g.ext.bot || 0);
      minLeft = Math.min(minLeft, x - (g.ext.left || 0));
      maxRight = Math.max(maxRight, x + g.w + (g.ext.right || 0));
      x += g.w + tracking;
    }
    const vbX = minLeft;
    const vbY = -maxTop;
    const vbW = Math.max(1, maxRight - minLeft);
    const vbH = 100 + maxTop + maxBot;

    const svgNS = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(svgNS, 'svg');
    svg.setAttribute('viewBox', `${vbX} ${vbY} ${vbW} ${vbH}`);
    svg.setAttribute('width', vbW * scale);
    svg.setAttribute('height', vbH * scale);
    svg.style.display = 'block';
    svg.style.overflow = 'visible';

    for (const { g, x } of placed) {
      if (!g.d) continue;
      const path = document.createElementNS(svgNS, 'path');
      path.setAttribute('d', g.d);
      path.setAttribute('transform', `translate(${x},0)`);
      path.setAttribute('fill', fill);
      if (g.rule) path.setAttribute('fill-rule', g.rule);
      svg.appendChild(path);
    }
    return svg;
  };
})();
